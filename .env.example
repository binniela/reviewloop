# Database. Unset = local PGlite database in .data/pglite (fine for development).
# Supabase: Connect > Transaction pooler (port 6543) on Vercel. Use the direct or session (5432)
# string only for one-off scripts (npm run migrate, pg_dump).
DATABASE_URL=
# Optional: the provider's CA certificate (PEM; \n escapes are fine) if the system trust store
# does not verify its certificate. Remote connections always verify the server.
DATABASE_CA_CERT=
# Connections per serverless instance (default 3 on Vercel, 5 elsewhere).
PG_POOL_MAX=
# Explicit demo mode; production does not silently fall back when DATABASE_URL is absent.
REVIEWLOOP_DEMO=

# The first GM account, created from these on first start (same username and password). After that,
# the GM adds everyone else on the Staff page. HTTP Basic checks active staff accounts; there is
# no permanent fallback to this deployment secret after the initial account is created. Rotate
# the first GM's password before inviting staff if the old shared password was known to others.
# Changing ADMIN_PASSWORD invalidates cookies and front desk PC registrations, not stored passwords.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Minutes without activity before a shared front desk PC goes back to "Who's at the desk?"
DESK_IDLE_MINUTES=15

# Bearer token for GET /cron/tick and POST /api/ingest/:propertyId
CRON_SECRET=
# Read-only bearer token for the uptime monitor's GET /health/alerts. Give the monitoring service
# this, never CRON_SECRET (which can also import reservations).
MONITOR_TOKEN=

# Public https URL of this app. Needed to verify Twilio webhooks and for links in staff alerts.
PUBLIC_URL=
# Development only: accept inbound texts without a Twilio signature
ALLOW_UNSIGNED_WEBHOOKS=

# Local only: run the scheduler every N seconds instead of an external cron
LOCAL_TICK_SECONDS=300

# Guest messages. Anything other than "live" prints messages instead of sending them.
MESSAGING_MODE=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional: each hotel's own number (properties.sms_from) is used when set
TWILIO_MESSAGING_SERVICE_SID=
# In Twilio, point each hotel number's "A message comes in" webhook to {PUBLIC_URL}/webhooks/twilio/sms (HTTP POST)
RESEND_API_KEY=
EMAIL_FROM=stays@yourdomain.com

# Google Business Profile (OAuth client with business.manage scope + refresh token).
# Unset = mock review source with no reviews.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Reply drafting. Unset = simple templates.
ANTHROPIC_API_KEY=
# Review reply drafts
ANTHROPIC_MODEL=claude-sonnet-5-5
# Triaging guest texts (fast and cheap). Keyword rules are used if there's no API key.
ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-5-5

# Installer links on /welcome. Unset = "Ask your Reviewloop contact for the installer".
DOWNLOAD_MAC_URL=
DOWNLOAD_WINDOWS_URL=
DOWNLOAD_CHROME_URL=
