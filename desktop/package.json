{
  "name": "reviewloop-desktop",
  "productName": "Reviewloop",
  "version": "0.1.0",
  "description": "Reviewloop for the front desk: guest issues, review replies and pilot metrics.",
  "author": "Reviewloop",
  "license": "ISC",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "configure": "node configure.js",
    "signing:check": "node -e \"const {plan}=require('./build.js');const p=plan();console.log(p.problems.length?'Missing:\\n- '+p.problems.join('\\n- '):'Signing is ready for '+(process.argv.slice(1).join(' ')||'Mac and Windows'));process.exit(p.problems.length?1:0)\"",
    "dist": "node build.js",
    "dist:mac": "node build.js --mac",
    "dist:win": "node build.js --win"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "com.reviewloop.desktop",
    "productName": "Reviewloop",
    "copyright": "Reviewloop",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "pages/**",
      "app-config.json",
      "build/badge.png"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "title": "Reviewloop"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Reviewloop",
      "createDesktopShortcut": true
    },
    "artifactName": "Reviewloop-${version}-${os}-${arch}.${ext}"
  }
}
