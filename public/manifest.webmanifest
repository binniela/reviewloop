{
  "name": "Reviewloop",
  "short_name": "Reviewloop",
  "description": "Guest issues, review replies and pilot metrics for your hotels.",
  "id": "/issues",
  "start_url": "/issues",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#FBFAF7",
  "theme_color": "#29251E",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Guest issues", "url": "/issues", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Review replies", "url": "/", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
